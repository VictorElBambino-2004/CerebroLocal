<% winner = @ranking.first %>
<% max_score = [winner["score"].to_f, 1].max %>

<%# Podio del ganador %>
<div class="cl-podium-winner">
  <div class="trophy">🏆</div>
  <h2><%= h(winner["name"]) %></h2>
  <div class="score"><%= winner["score"] %> Puntos</div>
</div>

<%# Ranking completo %>
<% medals = ["🥇", "🥈", "🥉"] %>
<div class="cl-ranking-list">
  <% @ranking.each_with_index do |player, index| %>
    <div class="cl-ranking-row">
      <span class="medal"><%= medals[index] || "#{index + 1}°" %></span>
      <span class="pname"><%= h(player["name"]) %></span>
      <div class="cl-bar-track">
        <div class="cl-bar-fill" style="width: <%= (player["score"].to_f / max_score * 100).round %>%;"></div>
      </div>
      <span class="pscore"><%= player["score"] %> pts</span>
    </div>
  <% end %>
</div>

<%# Botón e indicador %>
<div style="text-align: center;">
  <%= link_to "🏠 Volver al Inicio", root_path, class: "cl-btn cl-btn--indigo", style: "display: inline-block; width: auto; padding: 13px 32px;" %>
  <p style="color: var(--cl-muted); font-size: 0.82rem; margin-top: 14px;">
    Redirigiendo al inicio en <strong id="timer">6</strong>s...
  </p>
</div>

<script>
  let s = 6;
  const t = document.getElementById('timer');
  const iv = setInterval(() => {
    s -= 1;
    if (t) t.textContent = s;
    if (s <= 0) { clearInterval(iv); window.location.href = "<%= root_path %>"; }
  }, 1000);
</script>
